{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "allowJs": true, "checkJs": true, "strict": true, "resolveJsonModule": true,
    "esModuleInterop": true, "skipLibCheck": true, "isolatedModules": true,
    "verbatimModuleSyntax": true, "noEmit": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
