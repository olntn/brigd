{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "skipLibCheck": true, "esModuleInterop": true, "noEmit": true,
    "resolveJsonModule": true, "types": ["bun"]
  },
  "include": ["server/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "e2e/**/*.ts", "playwright.config.ts", "src/lib/types.ts"]
}
